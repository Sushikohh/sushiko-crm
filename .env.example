# =====================================================================
# Akquise-CRM – Konfiguration
# Kopieren nach .env (lokal) bzw. als Secrets im Hosting hinterlegen.
# Fehlende externe Dienste werden in der Oberfläche als „Nicht verbunden“ angezeigt.
# =====================================================================

# --- Anwendung -------------------------------------------------------
# Öffentliche URL (für Abmeldelinks in E-Mails und Webhooks)
APP_URL=https://crm.ihre-firma.de
NODE_ENV=production
LOG_LEVEL=info

# --- Datenbank (Supabase PostgreSQL, EU-Region z. B. Frankfurt eu-central-1) ---
# Server-Verbindung mit der Rolle „postgres“ (umgeht RLS – nur serverseitig verwenden!).
# Supabase: Project Settings → Database → Connection string → „Session pooler“ (Port 5432).
DATABASE_URL=postgres://postgres.xxxxxxxx:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10

# --- Authentifizierung ----------------------------------------------
# supabase = Supabase Auth (empfohlen in Produktion) | local = eigene Benutzerverwaltung
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur für Mitarbeiter-Einladungen aus der App (niemals im Browser verwenden)
SUPABASE_SERVICE_ROLE_KEY=
# Nur bei AUTH_PROVIDER=local: mindestens 32 Zeichen (openssl rand -hex 32)
AUTH_SECRET=

# --- Verschlüsselung -------------------------------------------------
# 32 Byte, base64 (openssl rand -base64 32). Verschlüsselt Postfach-Passwörter.
# ACHTUNG: Bei Verlust müssen die Postfach-Passwörter neu eingegeben werden.
APP_ENCRYPTION_KEY=

# --- E-Mail-Postfach (optional – alternativ in Einstellungen → E-Mail) ---
# Wird beim ersten Worker-Start einmalig als Postfach angelegt.
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
# 465 = TLS, 587 = STARTTLS (erzwungen)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# --- Brevo (optional, API-Versand für Kampagnen mit Einwilligung) ---
BREVO_API_KEY=
# Geheimes Token für den Webhook: https://crm.ihre-firma.de/api/webhooks/brevo?token=...
BREVO_WEBHOOK_SECRET=

# --- KI ----------------------------------------------------------------
# anthropic | openai | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Firmenfinder ------------------------------------------------------
# OpenStreetMap über Overpass-API (ODbL, frei nutzbar mit Namensnennung)
FINDER_OSM_ENABLED=true
FINDER_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Kontaktadresse im User-Agent (Overpass-Nutzungsrichtlinie)
FINDER_CONTACT_EMAIL=

# --- Worker ------------------------------------------------------------
WORKER_CONCURRENCY=2
